[
  {
    "context": "Workspace",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-alt-1": ["agent::SwitchWorkspaceMode", { "mode_index": 0 }],
      "ctrl-alt-2": ["agent::SwitchWorkspaceMode", { "mode_index": 1 }],
      "ctrl-alt-3": ["agent::SwitchWorkspaceMode", { "mode_index": 2 }],
      "ctrl-alt-4": ["agent::SwitchWorkspaceMode", { "mode_index": 3 }],
      "ctrl-alt-5": ["agent::SwitchWorkspaceMode", { "mode_index": 4 }],
      "ctrl-alt-6": ["agent::SwitchWorkspaceMode", { "mode_index": 5 }],
      "ctrl-alt-7": ["agent::SwitchWorkspaceMode", { "mode_index": 6 }],
      "ctrl-alt-8": ["agent::SwitchWorkspaceMode", { "mode_index": 7 }],
      "ctrl-alt-9": ["agent::SwitchWorkspaceMode", { "mode_index": 8 }]
    }
  },
  {
    "context": "OrchestratorComposer > Editor",
    "use_key_equivalents": true,
    "bindings": {
      "enter": "orchestrator_panel::Send",
      "tab": "orchestrator_panel::Queue",
      "escape": "orchestrator_panel::HardStop"
    }
  },
  {
    "context": "OrchestratorComposer > Editor && menu_open",
    "use_key_equivalents": true,
    "bindings": {
      "up": "orchestrator_panel::TypeaheadUp",
      "down": "orchestrator_panel::TypeaheadDown",
      "tab": "orchestrator_panel::TypeaheadAccept",
      "enter": "orchestrator_panel::TypeaheadAccept",
      "escape": "orchestrator_panel::TypeaheadDismiss"
    }
  },
  {
    "context": "AdversaryComposer > Editor",
    "use_key_equivalents": true,
    "bindings": {
      "enter": "adversary_panel::Broadcast"
    }
  }
]
